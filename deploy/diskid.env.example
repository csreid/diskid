# Copy to /etc/diskid/diskid.env  (chmod 640; it holds an API key)

# ARM's COMPLETED_PATH
DISKID_WATCH_DIR=/home/arm/media/completed

# Directory holding en.zip (the 35 GB OPUS OpenSubtitles raw English archive).
# The service writes en.episodes.tsv here on first run, so it must be writable.
DISKID_SUBTITLE_DIR=/var/lib/diskid-subtitles

# Extra `diskid watch` flags. --stt-url points at an OpenAI-compatible
# transcription server (e.g. Speaches in your cluster); the Pi then does only
# ffmpeg + matching and needs no Whisper at all. Use --stt-model to pick the
# server's model name (default: Systran/faster-whisper-<--model>, i.e. -small).
DISKID_ARGS=--zip /var/lib/diskid-subtitles/en.zip --stt-url http://speaches.example:8000/v1 --stt-model Systran/faster-whisper-small --settle 180

# If the STT server requires a bearer token
#DISKID_STT_API_KEY=

# For TMDB episode numbering (otherwise IMDb aired order is used, with a warning)
TMDB_APIKEY=
