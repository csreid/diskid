# Copy to /etc/diskid/diskid.env  (chmod 640; it holds an API key)

# Folders whose subfolders are discs (space-separated, no spaces in paths). ARM writes
# <COMPLETED_PATH>/<type>/<title>/, so watch <COMPLETED_PATH>/tv and /unidentified.
DISKID_WATCH_DIR=/srv/media/staging/tv /srv/media/staging/unidentified

# Directory holding en.zip (the 35 GB OPUS OpenSubtitles raw English archive).
# The service writes en.episodes.tsv here on first run, so it must be writable.
DISKID_SUBTITLE_DIR=/var/lib/diskid-subtitles

# Extra `diskid watch` flags. --stt-url points at an OpenAI-compatible
# transcription server (e.g. Speaches in your cluster); the Pi then does only
# ffmpeg + matching and needs no Whisper at all. Use --stt-model to pick the
# server's model name (default: Systran/faster-whisper-<--model>, i.e. -small).
DISKID_ARGS=--zip /var/lib/diskid-subtitles/en.zip --stt-url http://speaches.example:8000/v1 --stt-model Systran/faster-whisper-small --settle 180

# Where identified episodes go, and the Jinja path template under it. These are
# separate variables (not DISKID_ARGS) because systemd splits $DISKID_ARGS on
# spaces and ignores quotes. Leave both unset to rename in place.
#DISKID_OUTPUT_DIR=/srv/media/shows
#DISKID_TEMPLATE={{ show }}{% if year %} ({{ year }}){% endif %}/Season {{ season|pad }}/{{ show }} - {{ code }}{{ ext }}

# ARM's database. With ARM's own identification off, folders are named
# `None (None)`; diskid reads the disc label ARM recorded for each folder (read
# only) and derives the show name from it ("Orange_is_the_New_Black_Season_1_Disc_1"
# -> "Orange is the New Black").
#DISKID_ARM_DB=/home/arm/db/arm.db

# Discs ARM filed as movies, checked for being TV discs ARM mistook for films (a TV
# disc labelled 30_ROCK can come out as a Barbie movie). Movies are left untouched.
#DISKID_TRIAGE_DIR=/srv/media/staging/movies

# If the STT server requires a bearer token
#DISKID_STT_API_KEY=

# For TMDB episode numbering (otherwise IMDb aired order is used, with a warning)
TMDB_APIKEY=
